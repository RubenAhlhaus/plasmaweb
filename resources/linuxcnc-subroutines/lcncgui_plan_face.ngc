; lcncgui - Face milling (rectangular envelope, serpentine XY passes)
; Call: o<lcncgui_plan_face> call [#1] [#2] ... [#14]
;
; #1  areaStartX (mm)     — corner of programmed face; +X width / +Y height
; #2  areaStartY (mm)
; #3  areaWidth (mm)
; #4  areaHeight (mm)
; #5  cutterOverhangMm — stock extends this far beyond the face rectangle on all sides
; #6  surfaceZ (absolute, mm) — current stock top (for safe Z = #6 + #7)
; #7  vorschubHoeheMm — clearance above #6 for rapids (mm)
; #8  targetZ (absolute, mm) — finished face / cut height (single pass: Z = #8)
; #9  stepOver (mm) — lateral spacing between passes (cutter centre path, typical CAM stepover)
; #10 feedXY (mm/min)
; #11 feedZ (mm/min)
; #12 reserved (0) — future path pattern; ignored
; #13 coolant: >0.5 → M8 before cut, M9 after retract
; #14 tool diameter (mm) from GUI when known; if ≤0, effective diameter = #9/0.45 (rough fallback)
;
; Spindle M3 S… is issued in the main program before this call; tool change T… M6 as well.
; Initial approach: raise to safe Z only if below, then XY, then Z (see README).

o<lcncgui_plan_face> sub
  G90 G17

  #<_dia> = #14
  o100 if [#<_dia> LE 0]
    #<_dia> = [#9 / 0.45]
  o100 endif
  #<_r> = [#<_dia> / 2.0]

  #<_sx> = [#1 - #5]
  #<_sy> = [#2 - #5]
  #<_ex> = [#1 + #3 + #5]
  #<_ey> = [#2 + #4 + #5]

  #<_xmin> = [#<_sx> + #<_r>]
  #<_xmax> = [#<_ex> - #<_r>]
  #<_ymin> = [#<_sy> + #<_r>]
  #<_ymax> = [#<_ey> - #<_r>]

  #<_safez> = [#6 + #7]
  #<_cutz> = #8

  o101 if [#13 GT 0.5]
    M8
  o101 endif

  #<_cx> = [[#<_sx> + #<_ex>] / 2.0]
  #<_cy> = [[#<_sy> + #<_ey>] / 2.0]

  ; #<_z> is predefined current Z (read-only).
  o90 if [#<_z> LT #<_safez>]
    G0 Z#<_safez>
  o90 endif

  o110 if [#<_xmax> LT #<_xmin>]
    G0 X#<_cx> Y#<_cy>
    G0 Z#<_safez>
    G1 Z#<_cutz> F#11
  o110 else
    o111 if [#<_ymax> LT #<_ymin>]
      G0 X#<_cx> Y#<_cy>
      G0 Z#<_safez>
      G1 Z#<_cutz> F#11
    o111 else
      G0 X#<_xmin> Y#<_ymin>
      G0 Z#<_safez>
      G1 Z#<_cutz> F#11
      o112 if [#9 LE 0]
        ; Invalid stepover: avoid endless raster loop, keep one safe strip.
        G1 X#<_xmax> F#10
      o112 else
        o113 if [[#<_ymax> - #<_ymin>] LT 0.0005]
          G1 X#<_xmax> F#10
        o113 else
          G1 X#<_xmax> F#10
          ; Do not use #<_y> — it is a predefined read-only current-position param.
          #<_rowy> = #<_ymin>
          #<_to_right> = 1
          o200 while [#<_rowy> LT [#<_ymax> - 0.0005]]
            #<_yn> = [#<_rowy> + #9]
            o201 if [#<_yn> GT #<_ymax>]
              #<_yn> = #<_ymax>
            o201 endif
            G1 Y#<_yn> F#10
            o202 if [#<_to_right> GT 0.5]
              G1 X#<_xmin> F#10
              #<_to_right> = 0
            o202 else
              G1 X#<_xmax> F#10
              #<_to_right> = 1
            o202 endif
            #<_rowy> = #<_yn>
          o200 endwhile
        o113 endif
      o112 endif
    o111 endif
  o110 endif

  G0 Z#<_safez>
  o108 if [#13 GT 0.5]
    M9
  o108 endif
o<lcncgui_plan_face> endsub
